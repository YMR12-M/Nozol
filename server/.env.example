# ═══════════════════════════════════════════════════════════════
#  نُزُل — إعدادات السيرفر
#  انسخ هذا الملف إلى `.env` ثم عدّل القيم:   cp .env.example .env
#  كل متغيّر موثّق هنا. أي إعداد ناقص أو خطير في الإنتاج بيوقّف السيرفر
#  عند الإقلاع برسالة واضحة (config/env.js).
# ═══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=4010
API_PREFIX=/api/v1

# ── العناوين ────────────────────────────────────────────────────
# النطاقات المسموح لها تكلّم الـ API (مفصولة بفاصلة).
# لوحة الإدارة 5180 · تطبيق الموبايل 5181 · تطبيق Electron: app://nozol · Capacitor: capacitor://localhost,http://localhost
CLIENT_ORIGIN=http://localhost:5180,http://localhost:5181
# عنوان لوحة الإدارة كما يراه الناس (بيدخل في روابط البريد)
APP_URL=http://localhost:5180
# العنوان العام لصفحة الحجز (بتتحط في الـ widget وروابط التأكيد)
BOOKING_URL=http://localhost:5180/book
# العنوان العام للـ API (مطلوب في الإنتاج)
API_PUBLIC_URL=http://localhost:4010

# ── قاعدة البيانات (MySQL 8+) ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nozol
# قاعدة الاختبارات لازم تنتهي بـ _test — الاختبارات بتمسح بياناتها
DB_NAME_TEST=nozol_test
DB_CONNECTION_LIMIT=10
DB_SSL=false

# ── الجلسات والتوكنات ───────────────────────────────────────────
# ولّد كل سرّ بأمر مستقل:   openssl rand -base64 48   (32 حرفًا على الأقل في الإنتاج)
JWT_ACCESS_SECRET=dev-only-access-secret-not-for-production
JWT_ACCESS_TTL=15m
# مدّة التجديد للمتصفّح، وللتطبيقات (موبايل/ديسكتوب)
JWT_REFRESH_TTL=30d
JWT_REFRESH_TTL_APP=90d
BCRYPT_ROUNDS=12
# بعد كم محاولة دخول فاشلة يتقفل الحساب، ولمدّة كم دقيقة
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# كوكي التجديد (للمتصفّح). في الإنتاج: COOKIE_SECURE=true
COOKIE_SECURE=false
# Lax لو الواجهة والـ API على نفس الموقع (app.example.com و api.example.com).
# None لو على نطاقين مختلفين تمامًا (يتطلّب COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ── العلامة ─────────────────────────────────────────────────────
BRAND_NAME=نُزُل
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ── البريد (SMTP) ───────────────────────────────────────────────
# لو SMTP_HOST فاضي في التطوير: الرسائل بتتطبع في اللوج بدل ما تتبعت.
# في الإنتاج لازم SMTP أو MAIL_DISABLED=true صراحةً.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=نُزُل <no-reply@example.com>
MAIL_DISABLED=false

# ── إشعارات الموبايل (Web Push) ─────────────────────────────────
# ولّدها بـ:   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── الملفات المرفوعة ────────────────────────────────────────────
# مجلد التخزين (نسبي لمجلد server أو مطلق). في الإنتاج: قرص دائم.
UPLOADS_DIR=uploads
UPLOAD_MAX_FILE_MB=8
UPLOADS_PUBLIC_URL=

# ── التشغيل ─────────────────────────────────────────────────────
# المهام الخلفية: إلغاء الحجوزات المعلّقة المنتهية، مزامنة iCal، إرسال الإشعارات
JOBS_ENABLED=true
# تسجيل منظمات جديدة من الإنترنت (وضع SaaS). مقفول افتراضيًا.
ALLOW_SIGNUP=false

# ── أوّل تشغيل (db:bootstrap) ───────────────────────────────────
# تُقرأ مرّة واحدة لإنشاء المنظّمة وحساب المالك الأول، ثم احذف ADMIN_PASSWORD من الملف.
ORG_NAME=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
